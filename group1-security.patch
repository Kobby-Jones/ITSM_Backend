+// __tests__/unit/telemetry-authorization.test.js
+jest.mock('../../src/config/database', () => {
+  const transaction = {
+    device: {
+      findUnique: jest.fn(),
+      update: jest.fn(),
+      create: jest.fn(),
+    },
+    telemetryLog: {
+      create: jest.fn(),
