# ============================================================
#  ITSM BACKEND — PRODUCTION ENVIRONMENT
#  Copy to .env on the VM and fill in every value.
# ============================================================

# ── Domain ─────────────────────────────────────────────────────
DOMAIN=api.yourdomain.com

# ── Database ───────────────────────────────────────────────────
DB_USER=itsm_prod
DB_PASSWORD=CHANGE_ME_strong_random_password
DB_NAME=itsm_production

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_another_strong_password

# ── JWT (generate with: openssl rand -base64 64) ──────────────
JWT_SECRET=CHANGE_ME_64_chars_min
JWT_REFRESH_SECRET=CHANGE_ME_64_chars_min
JWT_RESET_SECRET=CHANGE_ME_64_chars_min
JWT_VERIFY_SECRET=CHANGE_ME_64_chars_min

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ITSM Platform <noreply@yourdomain.com>

# ── Firebase (optional — leave empty to skip push) ────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── App ────────────────────────────────────────────────────────
APP_NAME=ITSM Platform
MAX_FILE_SIZE=10485760
